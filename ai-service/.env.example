# AI 服务环境变量示例（复制为 .env 后填写，勿提交真实密钥）
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# OpenAI 兼容接口（DeepSeek / 通义 / 智谱 / OpenAI）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
CHROMA_PATH=.chroma
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# Redis：限流 + 近期会话缓存；不配置则进程内 memory 兜底
# 启动示例：docker compose -f docker-compose.redis.yml up -d
REDIS_URL=redis://127.0.0.1:6379/0

# 每用户每分钟最大调用次数
RATE_LIMIT_PER_MINUTE=20

# Java 业务回调（搜商品等）
JAVA_API_BASE=http://127.0.0.1:8081/api
JAVA_INTERNAL_TOKEN=

# 日志：INFO/DEBUG；文件在 ai-service/logs/ai-service.log（滚动）
LOG_LEVEL=INFO
LOG_DIR=logs
